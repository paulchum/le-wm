<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lewm_drone_ros</name>
  <version>0.1.0</version>
  <description>ROS2 bridge from drone_ai AutonomyKit decisions to AAS PX4 VTOL dynamic setpoints.</description>
  <maintainer email="paulchum1@gmail.com">paulchum</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>autopilot_interface_msgs</exec_depend>
  <exec_depend>lewm_drone_ros_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
